# ==========================================================
# logcollect Agent - .env 配置模板
# 复制为 .env 并按实际情况修改
# ==========================================================

# Agent 唯一标识（每台机器必须不同）
AGENT_ID=agent-docker-001

# 宿主机真实 hostname（必填！容器内 os.Hostname() 返回的是容器 ID，必须手动指定）
HOSTNAME=prod-server-01

# 管理后台地址（必填，填真实 IP 或域名，不能填 Docker 容器名）
ADMIN_URL=http://192.168.1.100:8080

# API Server 地址（必填，填真实 IP 或域名，不能填 Docker 容器名）
API_URL=http://192.168.1.100:8086

# 每个 API 请求携带的日志条数
BATCH_SIZE=50

# 缓冲区刷新间隔（秒）
FLUSH_SECONDS=5

# 推送并发数（同时发送的 HTTP 请求数，默认 5，apiserver 强可调大到 10-20）
PUSH_CONCURRENCY=5

# 资源限制
RESOURCE_MEMORY=256M
RESOURCE_CPUS=0.5
